# Copy to .env for local use. Never commit the real .env (see .gitignore).

# --- Django -----------------------------------------------------------
DEBUG=True
# Dev-only placeholder, not a production secret. Generate a real one for
# any non-local deployment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
SECRET_KEY=django-insecure-dev-only-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Optional discrete connection string; defaults to POSTGRES_* variables below.
DATABASE_URL=

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=event_management
POSTGRES_USER=event_management
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS / CSRF ----------------------------------------------------------
# Unused: single-origin Nginx proxy eliminates cross-origin requests.
# Kept for compatibility with potential multi-domain deployments.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Cookies / JWT --------------------------------------------------------
COOKIE_SECURE=False
ACCESS_TOKEN_LIFETIME_MINUTES=10
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email ----------------------------------------------------------------
# Recommended for cloud deployments (e.g. Render Free Tier where SMTP ports are blocked):
# Get a free API key at https://resend.com to send emails over HTTPS (port 443).
RESEND_API_KEY=
# Fallback SMTP settings (used if RESEND_API_KEY is unset).
# Leave both empty to print outgoing mail to the container log (console.EmailBackend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Logging --------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Demo data (seed_demo management command) -----------------------------
DEMO_USER_PASSWORD=demo12345
