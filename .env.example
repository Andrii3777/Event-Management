# Copy to .env for local use. Never commit the real .env (see .gitignore).

# --- Django -----------------------------------------------------------
DEBUG=True
# Dev-only placeholder, not a production secret. Generate a real one for
# any non-local deployment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
SECRET_KEY=django-insecure-dev-only-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Unused while backend and frontend share one origin via nginx (see
# spec §12/§5). Kept as a name only, as the brief lists it.
DATABASE_URL=

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=event_management
POSTGRES_USER=event_management
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS / CSRF ----------------------------------------------------------
# Unused: one origin (nginx) means no cross-origin requests, so
# django-cors-headers is never installed. Kept as a name only.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Cookies / JWT (consumed by apps.users, ticket 02) --------------------
COOKIE_SECURE=False
ACCESS_TOKEN_LIFETIME_MINUTES=10
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email ------------------------------------------------------------
# Leave EMAIL_HOST empty to print outgoing mail to the celery-worker log
# (django.core.mail.backends.console.EmailBackend). Set it to switch to SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Logging ------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Demo data (ticket 08 seed_demo) ---------------------------------------
DEMO_USER_PASSWORD=demo12345
